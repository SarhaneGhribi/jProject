DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=myfoundation

# used to sign login sessions - set this to a long random string
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# from Google Cloud Console > APIs & Services > Credentials (OAuth client ID,
# type "Web application", with http://localhost:3000 as an authorized origin).
# Must match REACT_APP_GOOGLE_CLIENT_ID in the frontend's .env.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# SMTP credentials used to send OTP / password-reset emails.
# Leave blank during development: emails are printed to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ghribi Foundation <no-reply@ghribifoundation.local>"

OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_EXPIRY_MINUTES=30

# used to build the link sent in password-reset emails
FRONTEND_URL=http://localhost:3000
